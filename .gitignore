# Rust
core/target/
# Generated by cbindgen during `cargo build`; regenerate with `just header`.
core/include/markdev.h

# Xcode — the project is generated from project.yml by `just generate`.
MarkDev.xcodeproj/
build/
DerivedData/
*.xcuserstate
xcuserdata/

# The app icon and the Markdown document icon are rendered from
# app/MarkDevKit/Brand/MarkDevLogo.swift by `just icons`; the geometry is the
# source, the PNGs and the .icns are build output.
app/MarkDev/Assets.xcassets/
app/MarkDev/Resources/

# Info.plists are generated from project.yml by xcodegen.
app/MarkDevKit/Info.plist
app/MarkDev/Info.plist
app/MarkDevQuickLook/Info.plist

# macOS
.DS_Store
